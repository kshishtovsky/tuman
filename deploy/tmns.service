[Unit]
Description=TMN/1 server (tmns)
Documentation=file:///usr/share/doc/tmn/README.md
After=network-online.target
Wants=network-online.target
# Не стартуем, пока владелец не создал конфиг: порт 443 занят Caddy (см. README).
ConditionPathExists=/etc/tmn/tmns.toml
# Ограничиваем флап, чтобы демон не долбился в занятый порт.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tmn
Group=tmn
ExecStart=/usr/local/bin/tmns --config /etc/tmn/tmns.toml
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s

# Лимиты: 800 Мбит/с на поток и много соединений.
LimitNOFILE=1048576
LimitNPROC=8192
Nice=-5
OOMScoreAdjust=-200
TasksMax=4096
MemoryMax=2G

# Привилегии: только bind на 443, всё остальное запрещено.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# ФС только для чтения, RW — /var/lib/tmn и /var/log/tmn (их создаёт systemd).
ProtectSystem=strict
ProtectHome=yes
StateDirectory=tmn
StateDirectoryMode=0700
LogsDirectory=tmn
LogsDirectoryMode=0700
ReadWritePaths=/var/lib/tmn /var/log/tmn
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
